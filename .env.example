# eHealthwares storefront (Next.js) — environment contract.
# Copy to .env.local and fill in. Never commit real secrets.
#
# NEXT_PUBLIC_* values are inlined at BUILD time. Server-only values (API_URL,
# IDENTITY_URL, INTERNAL_API_KEY) are read at runtime.

# ── Core ────────────────────────────────────────────────────
PORT=8007
HOSTNAME=0.0.0.0
NODE_ENV=development

# ── Backend endpoints ───────────────────────────────────────
# Server-side base for the storefront API.
API_URL=http://localhost:8002/api
# Optional build-time override for browser-side calls; empty = same origin.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONVERSATION_API_URL=/api/conversation
NEXT_PUBLIC_CONVERSATION_SOCKET_URL=ws://localhost:8004

# ── Identity / MyAIHA ───────────────────────────────────────
IDENTITY_URL=http://localhost:8001
MYAIHA_IDENTITY_URL=
MYAIHA_CONVERSATION_API_URL=
MYAIHA_CONVERSATION_SOCKET_URL=
# Shared service-to-service key; must match the backend's INTERNAL_API_KEY.
INTERNAL_API_KEY=

# ── Cache ───────────────────────────────────────────────────
CACHE_TTL_SECONDS=60
